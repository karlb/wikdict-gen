# dbnary fixture (English edition) for the end-to-end pipeline test.

@prefix dbnary:  <http://kaiko.getalp.org/dbnary#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lexvo:   <http://lexvo.org/id/iso639-3/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix eng:     <http://kaiko.getalp.org/dbnary/eng/> .

# --- house (noun) ----------------------------------------------------------
eng:house  a dbnary:Page ;
    dbnary:describes eng:house__Noun__1 .

eng:house__Noun__1  a ontolex:LexicalEntry, lexinfo:Noun ;
    rdfs:label "house"@en ;
    dcterms:language lexvo:eng ;
    lexinfo:partOfSpeech lexinfo:noun ;
    ontolex:canonicalForm eng:__cf_house ;
    ontolex:sense eng:__ws_house_1 .

eng:__cf_house  a ontolex:Form ;
    ontolex:writtenRep "house"@en .

eng:__ws_house_1  a ontolex:LexicalSense ;
    dbnary:senseNumber "1" ;
    skos:definition [ rdf:value "a building where people live"@en ] .

# house -> sv "hus" (the bridge that yields inferred de->sv "Haus" -> "hus")
eng:__tr_swe_house_1  a dbnary:Translation ;
    dbnary:isTranslationOf eng:house__Noun__1 ;
    dbnary:targetLanguage lexvo:swe ;
    dbnary:writtenForm "hus"@sv ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .

# house -> de "Haus" (gives the en->de pair data + a backlink)
eng:__tr_deu_house_1  a dbnary:Translation ;
    dbnary:isTranslationOf eng:house__Noun__1 ;
    dbnary:targetLanguage lexvo:deu ;
    dbnary:writtenForm "Haus"@de ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .

# --- go (verb) -------------------------------------------------------------
eng:go  a dbnary:Page ;
    dbnary:describes eng:go__Verb__1 .

eng:go__Verb__1  a ontolex:LexicalEntry, lexinfo:Verb ;
    rdfs:label "go"@en ;
    dcterms:language lexvo:eng ;
    lexinfo:partOfSpeech lexinfo:verb ;
    ontolex:canonicalForm eng:__cf_go ;
    ontolex:sense eng:__ws_go_1 .

eng:__cf_go  a ontolex:Form ;
    ontolex:writtenRep "go"@en .

eng:__ws_go_1  a ontolex:LexicalSense ;
    dbnary:senseNumber "1" ;
    skos:definition [ rdf:value "to move from one place to another"@en ] .

eng:__tr_swe_go_1  a dbnary:Translation ;
    dbnary:isTranslationOf eng:go__Verb__1 ;
    dbnary:targetLanguage lexvo:swe ;
    dbnary:writtenForm "gå"@sv ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .

eng:__tr_deu_go_1  a dbnary:Translation ;
    dbnary:isTranslationOf eng:go__Verb__1 ;
    dbnary:targetLanguage lexvo:deu ;
    dbnary:writtenForm "gehen"@de ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .
