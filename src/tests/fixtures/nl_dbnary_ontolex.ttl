# dbnary fixture (Dutch edition) for the end-to-end pipeline test.
# Second pivot for the de->sv "gehen" -> "åka" trap: like en "go", the Dutch
# motion verb "gaan" maps to both sv "gå" (correct) and sv "åka" (wrong). With
# two such pivots the bad target "åka" only survives under a plain sum() combine;
# the diminishing-returns combine (scoring.COMBINE_DECAY) drops it. See
# test_e2e.test_translation_quality.

@prefix dbnary:  <http://kaiko.getalp.org/dbnary#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lexvo:   <http://lexvo.org/id/iso639-3/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix nld:     <http://kaiko.getalp.org/dbnary/nld/> .

# --- gaan (verb) -----------------------------------------------------------
nld:gaan  a dbnary:Page ;
    dbnary:describes nld:gaan__Werkwoord__1 .

nld:gaan__Werkwoord__1  a ontolex:LexicalEntry, lexinfo:Verb ;
    rdfs:label "gaan"@nl ;
    dcterms:language lexvo:nld ;
    lexinfo:partOfSpeech lexinfo:verb ;
    ontolex:canonicalForm nld:__cf_gaan ;
    ontolex:sense nld:__ws_gaan_1 .

nld:__cf_gaan  a ontolex:Form ;
    ontolex:writtenRep "gaan"@nl .

nld:__ws_gaan_1  a ontolex:LexicalSense ;
    dbnary:senseNumber "1" ;
    skos:definition [ rdf:value "zich voortbewegen"@nl ] .

# gaan -> de "gehen" (backlink that validates the de->nl first hop)
nld:__tr_deu_gaan_1  a dbnary:Translation ;
    dbnary:isTranslationOf nld:gaan__Werkwoord__1 ;
    dbnary:targetLanguage lexvo:deu ;
    dbnary:writtenForm "gehen"@de ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .

# gaan -> sv "gå" (correct) and -> sv "åka" (the polysemy trap)
nld:__tr_swe_gaan_1  a dbnary:Translation ;
    dbnary:isTranslationOf nld:gaan__Werkwoord__1 ;
    dbnary:targetLanguage lexvo:swe ;
    dbnary:writtenForm "gå"@sv ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .

nld:__tr_swe_gaan_aka_1  a dbnary:Translation ;
    dbnary:isTranslationOf nld:gaan__Werkwoord__1 ;
    dbnary:targetLanguage lexvo:swe ;
    dbnary:writtenForm "åka"@sv ;
    dbnary:gloss [ dbnary:senseNumber "1" ] .
